#!/usr/bin/env python3
"""
Quick Launch - macOS Spotlight-style Application Launcher for Linux
Built with Python 3, GTK 3, and Gio.
"""

import sys
import os
import signal
import fcntl
import time
import json
import math
import subprocess
import urllib.parse
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gtk, Gdk, Gio, GLib, GLibUnix

VERSION = "1.2.1"
CACHE_DIR = os.path.expanduser("~/.cache/quick-launch")
HISTORY_FILE = os.path.join(CACHE_DIR, "history.json")

# Premium Spotlight Dark Theme
CSS = b"""

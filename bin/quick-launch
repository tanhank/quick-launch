#!/usr/bin/env python3
"""
Quick Launch - macOS Spotlight-style Application Launcher for Linux
Built with Python 3, GTK 3, and Gio.
"""

import sys
import os
import signal
import json
import math
import subprocess
import urllib.parse
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gtk, Gdk, Gio, GLib

VERSION = "1.1.0"
CACHE_DIR = os.path.expanduser("~/.cache/quick-launch")
HISTORY_FILE = os.path.join(CACHE_DIR, "history.json")

# Premium Frosted Dark Acrylic Theme (macOS Spotlight / Raycast aesthetic)
CSS = b"""
window {
    background-color: rgba(28, 29, 36, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.65);
}

.search-box {
    padding: 12px 16px 10px 16px;
    background-color: transparent;
}

entry {
    background-color: rgba(255, 255, 255, 0.07);
    color: #ffffff;
    font-size: 18px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    padding: 12px 16px;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 10px;
    caret-color: #0a84ff;
    box-shadow: none;
}

entry:focus {
    border-color: #0a84ff;
    background-color: rgba(255, 255, 255, 0.10);
}

.divider {
    background-color: rgba(255, 255, 255, 0.08);
    min-height: 1px;
}

scrolledwindow {
    border: none;
    background-color: transparent;
    padding: 4px 8px;
}

